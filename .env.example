# Database: Neon Postgres (EU, Frankfurt). Pooled URL for the app, direct URL for migrations/backups.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public site URL (used in emails and links)
NEXT_PUBLIC_SITE_URL=https://uithoorn.online

# Transactional email (Resend). Without a key, emails are logged as 'skipped' in email_outbox and
# magic-link login is switched off (password login keeps working).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Uithoorn.online <noreply@uithoorn.online>"
# Extra address that receives owner notifications (uithoorn.online@mail.tab.bot always does)
OWNER_NOTIFY_EMAIL=

# Protects /api/cron/retention (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Business payments are handled manually via WhatsApp (no checkout yet; Mollie seam in lib/billing).
# Use the international number without +, spaces or punctuation.
NEXT_PUBLIC_WHATSAPP_NUMBER=31616270233

# Local development only: allow the session cookie over http://localhost
# INSECURE_COOKIES=1
