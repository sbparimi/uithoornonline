# Supabase — existing provider/database fallback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL
NEXT_PUBLIC_SITE_URL=https://uithoorn.online

# Primary OSS LLM stack: llama.cpp server -> LiteLLM -> existing providers
LLM_PROVIDER_ORDER=llama_cpp,litellm,groq,bedrock,openai
LLAMA_CPP_BASE_URL=
LLAMA_CPP_MODEL=uithoorn-agent
LLAMA_CPP_API_KEY=
LITELLM_BASE_URL=
LITELLM_MODEL=uithoorn-agent
LITELLM_API_KEY=

# Optional local-development Ollama compatibility provider
OLLAMA_BASE_URL=
OLLAMA_MODEL=gpt-oss

# Existing LLM fallbacks
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Primary provider search: Typesense -> existing Supabase records
TYPESENSE_URL=
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION=providers

# Primary open provider discovery: OpenStreetMap/Nominatim -> optional Overpass -> existing Google Places
# For production/high traffic, point NOMINATIM_BASE_URL at infrastructure you control.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Primary observability: Langfuse OSS/self-hosted; console/Vercel logs remain fallback
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production

# Optional transactional email provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Uithoorn.online <noreply@uithoorn.online>"
